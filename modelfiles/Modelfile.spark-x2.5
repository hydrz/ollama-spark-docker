# Modelfile for Spark-X2.5 GGUF
# 将你下载的 Spark-X2.5 GGUF 文件放置在宿主机的 ./models 目录下（例如 spark-x2.5-4b.gguf）
# 容器内对应的路径为 /models/spark-x2.5-4b.gguf

FROM /models/spark-x2.5-4b.gguf

# 默认上下文建议设置为 32K 或 64K（按需平衡速度与容量）
PARAMETER num_ctx 65536

# 预测长度与采样参数
PARAMETER num_predict 1024
PARAMETER temperature 0.3
PARAMETER top_p 0.95
PARAMETER top_k 40

# 停止符设置
PARAMETER stop "<|end|>"
PARAMETER stop "<|user|>"
PARAMETER stop "<|assistant|>"

# 对话模版
TEMPLATE """{{ if .System }}<|system|>
{{ .System }}<|end|>
{{ end }}{{ if .Prompt }}<|user|>
{{ .Prompt }}<|end|>
{{ end }}<|assistant|>
{{ .Response }}<|end|>"""

# 可选系统提示词
SYSTEM """你是科大讯飞研发的 Spark-X2.5 大语言模型。你会诚实、准确、有条理地回答用户的各类问题。"""
