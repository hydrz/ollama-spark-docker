# 1. 指定基底文件
FROM modelscope.cn/XHToken/Spark-X2.5-4B-GGUF:Q4_K_M

# 2. 对齐官方元数据的系统人设
SYSTEM """you are a helpful assistant."""

# 3. 完整 Chat Template（包含思维链 <think>、工具协议与角色定界符）
TEMPLATE """{{- if .Messages }}
{{- if or .System .Tools }}<｜start▁of▁sentence｜><|System|>
{{- if .Tools }}
## Tools
You have access to the following functions:
<tools>
{{- range .Tools }}
{{ .Function }}
{{- end }}
</tools>
{{- end }}
{{- if .System }}
{{ .System }}
{{- else }}
you are a helpful assistant.
{{- end }}<｜end▁of▁sentence｜>
{{- end }}
{{- range .Messages }}
{{- if eq .Role "user" }}<｜start▁of▁sentence｜><|User|>{{ .Content }}<｜end▁of▁sentence｜>
{{- else if eq .Role "assistant" }}<｜start▁of▁sentence｜><|Bot|>
{{- if .Content }}</think>{{ .Content }}{{- end }}<｜end▁of▁sentence｜>
{{- else if eq .Role "tool" }}<｜start▁of▁sentence｜><|Tool|><tool_response>{{ .Content }}</tool_response><｜end▁of▁sentence｜>
{{- end }}
{{- end }}<｜start▁of▁sentence｜><|Bot|><think>
{{- else }}
{{- if .System }}<｜start▁of▁sentence｜><|System|>
{{ .System }}<｜end▁of▁sentence｜>{{ end }}
{{- if .Prompt }}<｜start▁of▁sentence｜><|User|>
{{ .Prompt }}<｜end▁of▁sentence｜>{{ end }}<｜start▁of▁sentence｜><|Bot|><think>
{{- end }}"""

# 4. 停止符（严格阻止模型自问自答或跨轮次胡言乱语）
PARAMETER stop "<｜end▁of▁sentence｜>"
PARAMETER stop "<｜start▁of▁sentence｜>"
PARAMETER stop "<|User|>"
PARAMETER stop "<|Bot|>"
PARAMETER stop "<|System|>"
PARAMETER stop "</tool_call>"

# 5. 官方推荐采样参数（来源于元数据 sampling.temp / sampling.top_p）
PARAMETER temperature 1.0
PARAMETER top_p 0.95
PARAMETER top_k -1

# 6. 上下文长度（元数据原生标称 1048576）
PARAMETER num_ctx 1048576